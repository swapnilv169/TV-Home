<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Starting dock, in this order. After that the dock is edited on the TV (hold OK or press Menu on an app)
         and saved on the device. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.amazon.firetv.youtube</item>
        <item>com.netflix.ninja</item>
        <item>com.amazon.firebat</item>
        <item>in.startv.hotstar</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.amazon.tv.livetv</string>

    <!-- Tiles per row in the grid, and the most apps the dock can hold. -->
    <integer name="columns">4</integer>
</resources>
